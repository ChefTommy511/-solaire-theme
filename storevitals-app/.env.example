# StoreVitals - Environment Variables
# Copy this file to .env and fill in your Shopify app credentials

SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_APP_URL=https://your-app-url.ngrok.io
SCOPES=read_products,read_themes,read_content

# Database - SQLite (auto-created, no config needed)
DATABASE_URL="file:./prisma/dev.db"
