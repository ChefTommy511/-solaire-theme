      {
        "type": "richtext",
        "id": "footer_newsletter_subtext",
        "label": "t:settings_schema.footer.newsletter_subtext.label",
        "default": "<p>Early access to new drops and exclusive offers.</p>"
      },
      {
        "type": "checkbox",
        "id": "footer_show_payment_icons",
        "label": "t:settings_schema.footer.show_payment_icons.label",
        "default": true
      },
      {
        "type": "select",
        "id": "footer_color_scheme",
        "label": "t:settings_schema.footer.color_scheme.label",
        "options": [
          { "value": "light", "label": "t:settings_schema.footer.color_scheme.options.light" },
          { "value": "dark", "label": "t:settings_schema.footer.color_scheme.options.dark" }
        ],
        "default": "dark"
      },
      {
        "type": "richtext",
        "id": "footer_copyright_text",
        "label": "t:settings_schema.footer.copyright_text.label",
        "default": "<p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>"
      },
      {
        "type": "checkbox",
        "id": "footer_show_language_selector",
        "label": "t:settings_schema.footer.show_language_selector.label",
        "default": true,
        "info": "t:settings_schema.footer.show_language_selector.info"
      },
      {
        "type": "checkbox",
        "id": "footer_show_currency_selector",
        "label": "t:settings_schema.footer.show_currency_selector.label",
        "default": true,
        "info": "t:settings_schema.footer.show_currency_selector.info"
      }
    ]
  },
