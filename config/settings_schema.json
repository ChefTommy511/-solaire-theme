  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.typography.header"
      },
      {
        "type": "select",
        "id": "font_heading",
        "label": "t:settings_schema.typography.heading_font.label",
        "options": [
          { "value": "playfair", "label": "t:settings_schema.typography.heading_font.options.playfair" },
          { "value": "cormorant", "label": "t:settings_schema.typography.heading_font.options.cormorant" },
          { "value": "bodoni", "label": "t:settings_schema.typography.heading_font.options.bodoni" },
          { "value": "tenor_sans", "label": "t:settings_schema.typography.heading_font.options.tenor_sans" },
          { "value": "system_serif", "label": "t:settings_schema.typography.heading_font.options.system_serif" }
        ],
        "default": "playfair"
      },
      {
        "type": "select",
        "id": "font_body",
        "label": "t:settings_schema.typography.body_font.label",
        "options": [
          { "value": "inter", "label": "t:settings_schema.typography.body_font.options.inter" },
          { "value": "lato", "label": "t:settings_schema.typography.body_font.options.lato" },
          { "value": "work_sans", "label": "t:settings_schema.typography.body_font.options.work_sans" },
          { "value": "system_sans", "label": "t:settings_schema.typography.body_font.options.system_sans" }
        ],
        "default": "inter"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "t:settings_schema.typography.base_size.label",
        "min": 14,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 16
      },
      {
        "type": "range",
        "id": "font_scale_ratio",
        "label": "t:settings_schema.typography.scale_ratio.label",
        "info": "t:settings_schema.typography.scale_ratio.info",
        "min": 1.1,
        "max": 1.5,
        "step": 0.1,
        "default": 1.3,
        "unit": "×"
      },
      {
        "type": "range",
        "id": "font_weight_heading",
        "label": "t:settings_schema.typography.heading_weight.label",
        "min": 300,
        "max": 900,
        "step": 100,
        "default": 400
      },
      {
        "type": "range",
        "id": "font_weight_body",
        "label": "t:settings_schema.typography.body_weight.label",
        "min": 300,
        "max": 500,
        "step": 100,
        "default": 400
      },
      {
        "type": "range",
        "id": "letter_spacing_heading",
        "label": "t:settings_schema.typography.heading_letter_spacing.label",
        "min": 0.0,
        "max": 0.2,
        "step": 0.1,
        "default": 0,
        "unit": "em"
      },
      {
        "type": "range",
        "id": "letter_spacing_body",
        "label": "t:settings_schema.typography.body_letter_spacing.label",
        "min": 0.0,
        "max": 0.1,
        "step": 0.1,
        "default": 0,
        "unit": "em"
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.header.header"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings_schema.header.logo.label"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "t:settings_schema.header.logo_width.label",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "default": 140
      },
      {
        "type": "select",
        "id": "logo_position",
        "label": "t:settings_schema.header.logo_position.label",
        "options": [
          { "value": "left", "label": "t:settings_schema.header.logo_position.options.left" },
          { "value": "center", "label": "t:settings_schema.header.logo_position.options.center" }
        ],
        "default": "center"
      },
      {
        "type": "select",
        "id": "menu_style",
        "label": "t:settings_schema.header.menu_style.label",
        "options": [
          { "value": "horizontal", "label": "t:settings_schema.header.menu_style.options.horizontal" },
          { "value": "drawer", "label": "t:settings_schema.header.menu_style.options.drawer" }
        ],
        "default": "horizontal"
      },
      {
        "type": "checkbox",
        "id": "enable_sticky_header",
        "label": "t:settings_schema.header.sticky.label",
        "default": true
      },
      {
        "type": "select",
        "id": "sticky_header_style",
        "label": "t:settings_schema.header.sticky_style.label",
        "options": [
          { "value": "always", "label": "t:settings_schema.header.sticky_style.options.always" },
          { "value": "on_scroll_up", "label": "t:settings_schema.header.sticky_style.options.on_scroll_up" }
        ],
        "default": "on_scroll_up"
      },
      {
        "type": "checkbox",
        "id": "enable_transparent_header",
        "label": "t:settings_schema.header.transparent.label",
        "info": "t:settings_schema.header.transparent.info",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_search",
        "label": "t:settings_schema.header.show_search.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_account_icon",
        "label": "t:settings_schema.header.show_account.label",
        "default": true
      },
      {
        "type": "select",
        "id": "header_padding",
        "label": "t:settings_schema.header.padding.label",
        "options": [
          { "value": "compact", "label": "t:settings_schema.header.padding.options.compact" },
          { "value": "standard", "label": "t:settings_schema.header.padding.options.standard" },
          { "value": "spacious", "label": "t:settings_schema.header.padding.options.spacious" }
        ],
        "default": "standard"
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.footer.header"
      },
      {
        "type": "checkbox",
        "id": "footer_show_social",
        "label": "t:settings_schema.footer.show_social.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "footer_show_newsletter",
        "label": "t:settings_schema.footer.show_newsletter.label",
        "default": true
      },
      {
        "type": "richtext",
        "id": "footer_newsletter_heading",
