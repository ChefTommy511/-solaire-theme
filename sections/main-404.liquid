{%- comment -%}
  Solaire Theme — 404 Page Section
  Clean, on-brand not-found page with search and navigation.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading | default: 'Page not found'
  assign subtext = section.settings.subtext | default: 'The page you\'re looking for doesn\'t exist or has been moved.'
  assign button_text = section.settings.button_text | default: 'Continue shopping'
  assign show_search = section.settings.show_search | default: true
  assign show_collections = section.settings.show_collections | default: true
  assign collections_list = section.settings.collections_list
-%}

<div class="main-404 page-width">
  <div class="main-404__content">
    <h1 class="main-404__code">404</h1>
    <h2 class="main-404__title">{{ heading | escape }}</h2>
    <p class="main-404__subtext">{{ subtext | escape }}</p>

    {%- if show_search -%}
      <div class="main-404__search">
        <form action="{{ routes.search_url }}" method="get" role="search" class="main-404__search-wrapper">
          <input
            type="search"
            name="q"
            class="main-404__search-input"
            placeholder="{{ 'general.search.placeholder' | t }}"
            aria-label="{{ 'general.search.search' | t }}"
            autocomplete="off"
          >
          <button type="submit" class="main-404__search-submit" aria-label="{{ 'general.search.submit' | t }}">
            {%- render 'icon-search' -%}
          </button>
        </form>
      </div>
    {%- endif -%}

    <div class="main-404__actions">
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--accent">
        {{ button_text | escape }}
      </a>
      <a href="{{ routes.root_url }}" class="btn btn--outline">
        {{ 'sections.main-404.view_home' | t }}
      </a>
    </div>

    {%- if show_collections and collections_list != blank and collections_list.count > 0 -%}
      <div class="main-404__collections">
        <h3 class="main-404__collections-title">{{ 'sections.main-404.featured_collections' | t }}</h3>
        <div class="main-404__collections-grid">
          {%- for collection in collections_list -%}
            <a href="{{ collection.url }}" class="main-404__collection-card">
              {%- if collection.featured_image -%}
                <div class="main-404__collection-image">
                  <img
                    src="{{ collection.featured_image | image_url: width: 400 }}"
                    alt="{{ collection.title | escape }}"
                    width="400"
                    height="300"
                    loading="lazy"
                  >
                </div>
              {%- endif -%}
              <span class="main-404__collection-title">{{ collection.title | escape }}</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-404.name",
  "class": "section-main-404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main-404.settings.heading.label",
      "default": "Page not found"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "t:sections.main-404.settings.subtext.label",
      "default": "The page you're looking for doesn't exist or has been moved."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:sections.main-404.settings.button_text.label",
      "default": "Continue shopping"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "t:sections.main-404.settings.show_search.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collections",
      "label": "t:sections.main-404.settings.show_collections.label",
      "default": true
    },
    {
      "type": "collection_list",
      "id": "collections_list",
      "label": "t:sections.main-404.settings.collections_list.label",
      "info": "t:sections.main-404.settings.collections_list.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-404.presets.name",
      "category": "404"
    }
  ]
}
{% endschema %}
