{%- comment -%}
  Solaire Theme — Testimonials Section
  Customer quotes and reviews to build social proof.
{%- endcomment -%}

<section class="testimonials section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="testimonials__heading section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="testimonials__grid testimonials__grid--cols-{{ section.settings.grid_columns | default: 3 }}">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars">
            {%- for i in (1..5) -%}
              {%- render 'icon-star' -%}
            {%- endfor -%}
          </div>

          {%- if block.settings.quote != blank -%}
            <blockquote class="testimonial-card__quote">
              <p>{{ block.settings.quote | escape }}</p>
            </blockquote>
          {%- endif -%}

          <div class="testimonial-card__author">
            {%- if block.settings.author_name != blank -%}
              <cite class="testimonial-card__name">{{ block.settings.author_name | escape }}</cite>
            {%- endif -%}
            {%- if block.settings.author_title != blank -%}
              <span class="testimonial-card__title">{{ block.settings.author_title | escape }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        <div class="testimonials__empty">
          <p>{{ 'sections.testimonials.empty' | t }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.testimonials.settings.heading.label",
      "default": "What our customers say"
    },
    {
      "type": "select",
      "id": "grid_columns",
      "label": "t:sections.testimonials.settings.grid_columns.label",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "t:sections.testimonials.blocks.testimonial.name",
      "settings": [
        {
          "type": "text",
          "id": "quote",
          "label": "t:sections.testimonials.blocks.testimonial.settings.quote.label",
          "default": "These are the best sunglasses I've ever owned. The quality is unmatched."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "t:sections.testimonials.blocks.testimonial.settings.author_name.label",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "author_title",
          "label": "t:sections.testimonials.blocks.testimonial.settings.author_title.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.testimonials.presets.name",
      "category": "Social proof",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
