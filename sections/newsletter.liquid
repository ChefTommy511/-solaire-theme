{%- comment -%}
  Solaire Theme — Newsletter Section
  Clean, minimal email signup with success/error states.
  Integrates with Shopify's customer form via the newsletter-form snippet.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign button_text = section.settings.button_text | default: 'Subscribe'
  assign placeholder_text = section.settings.placeholder_text | default: 'Enter your email'
  assign color_scheme = section.settings.color_scheme | default: 'dark'
-%}

<section
  class="newsletter section-spacing newsletter--{{ color_scheme }}"
  data-section-id="{{ section.id }}"
>
  <div class="page-width">
    <div class="newsletter__inner">
      {%- if heading != blank -%}
        <h2 class="newsletter__heading h3">{{ heading | escape }}</h2>
      {%- endif -%}

      {%- if subheading != blank -%}
        <p class="newsletter__subtext">{{ subheading | escape }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">

        <div class="newsletter-form__wrapper">
          <label for="NewsletterForm-{{ section.id }}" class="visually-hidden">
            {{ 'newsletter.label' | t }}
          </label>

          <div class="newsletter-form__input-group">
            <input
              id="NewsletterForm-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="newsletter-form__input"
              value="{{ form.email }}"
              placeholder="{{ placeholder_text | escape }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              required
            >

            <button
              type="submit"
              class="newsletter-form__button"
              name="commit"
            >
              <span class="newsletter-form__button-text">{{ button_text | escape }}</span>
              {%- render 'icon-arrow-right' -%}
            </button>
          </div>
        </div>

        {%- if form.errors -%}
          <div class="newsletter-form__message newsletter-form__message--error" role="alert">
            <p>{{ form.errors | default_errors }}</p>
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div class="newsletter-form__message newsletter-form__message--success" role="status">
            <p>{{ 'newsletter.success' | t }}</p>
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "Stay in the loop"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.newsletter.settings.subheading.label",
      "default": "Be the first to know about new drops and exclusive offers."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:sections.newsletter.settings.button_text.label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "t:sections.newsletter.settings.placeholder_text.label",
      "default": "Enter your email"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "t:sections.newsletter.settings.color_scheme.label",
      "options": [
        { "value": "dark", "label": "t:sections.newsletter.settings.color_scheme.options.dark" },
        { "value": "light", "label": "t:sections.newsletter.settings.color_scheme.options.light" },
        { "value": "accent", "label": "t:sections.newsletter.settings.color_scheme.options.accent" }
      ],
      "default": "dark"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name",
      "category": "Promotional"
    }
  ]
}
{% endschema %}