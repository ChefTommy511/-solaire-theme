{%- comment -%}
  Solaire Theme — Hero Banner Section
  Full-width hero with text overlay, perfect for showcasing sunglasses collections.
{%- endcomment -%}

<section class="hero-banner" data-section-id="{{ section.id }}">
  <div class="hero-banner__wrapper">
    {%- if section.settings.image != blank -%}
      <div class="hero-banner__media">
        {%- render 'lazy-image',
          image: section.settings.image,
          sizes: '100vw',
          class: 'hero-banner__image'
        -%}
      </div>
    {%- else -%}
      <div class="hero-banner__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-banner__placeholder-svg' }}
      </div>
    {%- endif -%}

    <div class="hero-banner__content hero-banner__content--{{ section.settings.content_position }}">
      <div class="hero-banner__text page-width">
        {%- if section.settings.heading != blank -%}
          <h1 class="hero-banner__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="hero-banner__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_text != blank -%}
          <a
            href="{{ section.settings.button_link | default: '#' }}"
            class="btn btn--{{ section.settings.button_style }}"
          >
            {{ section.settings.button_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.hero-banner.name",
  "class": "section-hero-banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero-banner.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "t:sections.hero-banner.settings.mobile_image.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero-banner.settings.heading.label",
      "default": "Elevate your look"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.hero-banner.settings.subheading.label",
      "default": "Premium eyewear designed for those who see differently"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:sections.hero-banner.settings.button_text.label",
      "default": "Shop collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero-banner.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.hero-banner.settings.button_style.label",
      "options": [
        { "value": "primary", "label": "t:sections.hero-banner.settings.button_style.options.primary" },
        { "value": "accent", "label": "t:sections.hero-banner.settings.button_style.options.accent" },
        { "value": "outline", "label": "t:sections.hero-banner.settings.button_style.options.outline" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:sections.hero-banner.settings.content_position.label",
      "options": [
        { "value": "center", "label": "t:sections.hero-banner.settings.content_position.options.center" },
        { "value": "left", "label": "t:sections.hero-banner.settings.content_position.options.left" },
        { "value": "right", "label": "t:sections.hero-banner.settings.content_position.options.right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.hero-banner.settings.overlay_opacity.label",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:sections.hero-banner.settings.section_height.label",
      "options": [
        { "value": "small", "label": "t:sections.hero-banner.settings.section_height.options.small" },
        { "value": "medium", "label": "t:sections.hero-banner.settings.section_height.options.medium" },
        { "value": "large", "label": "t:sections.hero-banner.settings.section_height.options.large" },
        { "value": "fullscreen", "label": "t:sections.hero-banner.settings.section_height.options.fullscreen" }
      ],
      "default": "large"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero-banner.presets.name",
      "category": "Hero"
    }
  ]
}
{% endschema %}
