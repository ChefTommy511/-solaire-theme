{%- comment -%}
  Solaire Theme — Main Password Section
  Password page section with store logo/title, password form, and marketing text.
  Used by the password template (templates/password.json).
{%- endcomment -%}

{%- liquid
  assign logo = section.settings.logo
  assign heading = section.settings.heading | default: shop.name
  assign subtext = section.settings.subtext | default: "We're working on something special. Enter your password to preview."
  assign placeholder_text = section.settings.placeholder_text | default: 'Enter store password'
  assign button_text = section.settings.button_text | default: 'Enter'
  assign marketing_text = section.settings.marketing_text
  assign show_social = section.settings.show_social | default: true
  assign background_image = section.settings.background_image
  assign overlay_opacity = section.settings.overlay_opacity | default: 40
  assign text_color = section.settings.text_color | default: 'light'
-%}

{%- style -%}
  .main-password {
    --overlay-opacity: {{ overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

<div class="main-password main-password--text-{{ text_color }}" data-section-id="{{ section.id }}">
  {%- if background_image != blank -%}
    <div class="main-password__background">
      <img
        src="{{ background_image | image_url: width: 2000 }}"
        alt="{{ heading | escape }}"
        width="2000"
        height="1400"
        loading="eager"
        class="main-password__background-image"
      >
    </div>
    <div class="main-password__overlay"></div>
  {%- endif -%}

  <div class="main-password__content">
    <div class="main-password__header">
      {%- if logo != blank -%}
        <div class="main-password__logo">
          <img
            src="{{ logo | image_url: width: 300 }}"
            alt="{{ shop.name | escape }}"
            width="300"
            height="80"
            loading="eager"
            class="main-password__logo-image"
          >
        </div>
      {%- else -%}
        <h1 class="main-password__title">{{ heading | escape }}</h1>
      {%- endif -%}
    </div>

    <div class="main-password__body">
      {%- if marketing_text != blank -%}
        <div class="main-password__marketing rte">
          {{ marketing_text }}
        </div>
      {%- endif -%}

      {%- unless subtext == blank -%}
        <p class="main-password__subtext">{{ subtext | escape }}</p>
      {%- endunless -%}

      <div class="main-password__form-wrapper">
        {%- form 'storefront_password', class: 'main-password__form' -%}
          <div class="main-password__form-field">
            <label
              for="password-{{ section.id }}"
              class="visually-hidden"
            >
              {{ placeholder_text | escape }}
            </label>
            <input
              type="password"
              name="password"
              id="password-{{ section.id }}"
              class="main-password__input"
              placeholder="{{ placeholder_text | escape }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              required
            >
            <button type="submit" class="main-password__submit btn btn--accent">
              {{ button_text | escape }}
            </button>
          </div>

          {%- if form.errors -%}
            <div class="main-password__errors">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>

      <p class="main-password__admin-link">
        {{ 'general.password.admin_link' | t }}
        <a href="/admin" class="main-password__admin-link-text">
          {{ 'general.password.admin_link_text' | t }}
        </a>
      </p>

      {%- if show_social -%}
        <div class="main-password__social">
          {%- render 'social-icons' -%}
        </div>
      {%- endif -%}
    </div>

    <div class="main-password__footer">
      <p class="main-password__powered-by">
        {{ 'general.password.powered_by' | t: shopify: shop.name }}
      </p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-password.name",
  "class": "section-main-password",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:sections.main-password.settings.logo.label",
      "info": "t:sections.main-password.settings.logo.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.main-password.settings.heading.label",
      "default": "Opening soon"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "t:sections.main-password.settings.subtext.label",
      "default": "We're working on something special. Enter your password to preview."
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "t:sections.main-password.settings.placeholder_text.label",
      "default": "Enter store password"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:sections.main-password.settings.button_text.label",
      "default": "Enter"
    },
    {
      "type": "richtext",
      "id": "marketing_text",
      "label": "t:sections.main-password.settings.marketing_text.label",
      "info": "t:sections.main-password.settings.marketing_text.info"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.main-password.settings.background_image.label",
      "info": "t:sections.main-password.settings.background_image.info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:sections.main-password.settings.overlay_opacity.label",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "t:sections.main-password.settings.text_color.label",
      "default": "light",
      "options": [
        { "value": "light", "label": "t:sections.main-password.settings.text_color.options.light" },
        { "value": "dark", "label": "t:sections.main-password.settings.text_color.options.dark" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:sections.main-password.settings.show_social.label",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-password.presets.name",
      "category": "Password"
    }
  ]
}
{% endschema %}
