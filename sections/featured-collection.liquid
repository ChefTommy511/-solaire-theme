{%- comment -%}
  Solaire Theme — Featured Collection Section
  Product showcase grid from a selected collection with hover effects and "view all" CTA.
{%- endcomment -%}

{%- liquid
  assign collection_handle = section.settings.collection
  assign collection = collections[collection_handle]
  assign products_limit = section.settings.products_to_show | default: 4
  assign grid_columns = section.settings.grid_columns | default: 4
  assign heading = section.settings.heading
  assign description = section.settings.description
  assign show_view_all = section.settings.show_view_all
-%}

<section class="featured-collection section-spacing{% if section.settings.background != 'none' %} featured-collection--bg-{{ section.settings.background }}{% endif %}" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if heading != blank -%}
      <h2 class="section-heading featured-collection__heading">{{ heading | escape }}</h2>
    {%- endif -%}

    {%- if description != blank -%}
      <div class="section-subheading featured-collection__description rte">{{ description }}</div>
    {%- endif -%}

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="featured-collection__grid featured-collection__grid--cols-{{ grid_columns }}">
        {%- for product in collection.products limit: products_limit -%}
          {%- render 'product-card',
            product: product,
            show_secondary_image: section.settings.show_secondary_image
          -%}
        {%- endfor -%}
      </div>

      {%- if show_view_all and collection.url != blank -%}
        <div class="featured-collection__cta">
          <a href="{{ collection.url }}" class="btn btn--outline">
            {{ 'sections.featured-collection.view_all' | t }}
            {%- render 'icon-arrow-right' -%}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="featured-collection__empty">
        <p>{{ 'sections.featured-collection.empty' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured-collection.settings.heading.label",
      "default": "Shop the collection"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.featured-collection.settings.description.label"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured-collection.settings.products_to_show.label",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "grid_columns",
      "label": "t:sections.featured-collection.settings.grid_columns.label",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "t:sections.featured-collection.settings.show_secondary_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured-collection.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:sections.featured-collection.settings.background.label",
      "options": [
        { "value": "none", "label": "t:sections.featured-collection.settings.background.options.none" },
        { "value": "secondary", "label": "t:sections.featured-collection.settings.background.options.secondary" }
      ],
      "default": "none"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.presets.name",
      "category": "Collection"
    }
  ]
}
{% endschema %}