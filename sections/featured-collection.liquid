{%- comment -%}
  Solaire Theme — Featured Collection Section
  Displays a product grid from a selected collection.
{%- endcomment -%}

{%- liquid
  assign collection_handle = section.settings.collection
  assign collection = collections[collection_handle]
  assign products_limit = section.settings.products_to_show | default: 4
  assign grid_columns = section.settings.grid_columns | default: 4
-%}

<section class="featured-collection section-spacing" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="featured-collection__heading section-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="featured-collection__subheading section-subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="featured-collection__grid featured-collection__grid--cols-{{ grid_columns }}">
        {%- for product in collection.products limit: products_limit -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all and collection.url != blank -%}
        <div class="featured-collection__cta">
          <a href="{{ collection.url }}" class="btn btn--outline">
            {{ 'sections.featured_collection.view_all' | t }}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="featured-collection__empty">
        <p>{{ 'sections.featured_collection.empty' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured-collection.name",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured-collection.settings.heading.label",
      "default": "Shop the collection"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.featured-collection.settings.subheading.label"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured-collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured-collection.settings.products_to_show.label",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "grid_columns",
      "label": "t:sections.featured-collection.settings.grid_columns.label",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured-collection.settings.show_view_all.label",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured-collection.presets.name",
      "category": "Collection"
    }
  ]
}
{% endschema %}
