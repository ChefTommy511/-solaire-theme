{%- comment -%}
  Solaire Theme — Newsletter Form Snippet
  Reusable email signup form for newsletter sections and footer.
{%- endcomment -%}

{%- form 'customer', class: 'newsletter-form' -%}
  <input type="hidden" name="contact[tags]" value="newsletter">

  <div class="newsletter-form__input-group">
    <label for="NewsletterForm-{{ section.id | default: 'footer' }}" class="visually-hidden">
      {{ 'newsletter.label' | t }}
    </label>

    <input
      id="NewsletterForm-{{ section.id | default: 'footer' }}"
      type="email"
      name="contact[email]"
      class="newsletter-form__input"
      value="{{ form.email }}"
      placeholder="{{ 'newsletter.placeholder' | t }}"
      aria-required="true"
      autocorrect="off"
      autocapitalize="off"
      autocomplete="email"
      required
    >

    <button type="submit" class="newsletter-form__button" name="commit">
      {{ 'newsletter.button_label' | t }}
    </button>
  </div>

  {%- if form.errors -%}
    <p class="newsletter-form__error" role="alert">
      {{ form.errors | default_errors }}
    </p>
  {%- endif -%}

  {%- if form.posted_successfully? -%}
    <p class="newsletter-form__success" role="status">
      {{ 'newsletter.success' | t }}
    </p>
  {%- endif -%}
{%- endform -%}
