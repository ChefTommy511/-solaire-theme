{%- comment -%}
  Solaire Theme — Variant Swatches Snippet
  Color/material swatch picker for product cards and product pages.
{%- endcomment -%}

{%- liquid
  assign product = product | default: nil
  unless product == nil
    assign swatch_option = product.options_with_values | where: 'name', 'Color' | first
    if swatch_option == nil
      assign swatch_option = product.options_with_values | first
    endif

    assign swatch_count = swatch_option.values.size
    assign max_display = 4
  endunless
-%}

{%- if swatch_option != blank and swatch_count > 0 -%}
  <ul class="variant-swatches" role="list" aria-label="{{ 'products.product.color_options' | t }}">
    {%- for value in swatch_option.values limit: max_display -%}
      <li class="variant-swatches__item">
        <span
          class="variant-swatches__swatch"
          data-value="{{ value | handle }}"
          title="{{ value | escape }}"
          {% if value.swatch.color %}
            style="background-color: {{ value.swatch.color }}"
          {% endif %}
        >
          <span class="visually-hidden">{{ value | escape }}</span>
        </span>
      </li>
    {%- endfor -%}

    {%- if swatch_count > max_display -%}
      <li class="variant-swatches__item">
        <span class="variant-swatches__more">
          +{{ swatch_count | minus: max_display }}
        </span>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}
