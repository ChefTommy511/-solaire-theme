{%- comment -%}
  Solaire Theme — Pagination Snippet
  Renders classic pagination for collections and search results.
{%- endcomment -%}

{%- liquid
  assign paginate = paginate | default: nil
-%}
{%- if paginate != nil and paginate.pages >= 2 -%}
<nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
  {%- if paginate.previous -%}
    <a href="{{ paginate.previous.url }}" class="pagination__item pagination__item--prev" aria-label="{{ 'general.pagination.previous' | t }}">
      {%- render 'icon-chevron-right', class: 'pagination__icon' -%}
    </a>
  {%- else -%}
    <span class="pagination__item pagination__item--disabled">
      {%- render 'icon-chevron-right', class: 'pagination__icon' -%}
    </span>
  {%- endif -%}

  {%- for part in paginate.parts -%}
    {%- if part.is_link -%}
      <a href="{{ part.url }}" class="pagination__item" aria-label="{{ 'general.pagination.page' | t: page: part.title }}">
        {{ part.title }}
      </a>
    {%- elsif part.title == paginate.current_page -%}
      <span class="pagination__item pagination__item--current" aria-current="page" aria-label="{{ 'general.pagination.page' | t: page: part.title }}">
        {{ part.title }}
      </span>
    {%- else -%}
      <span class="pagination__item pagination__item--gap">&hellip;</span>
    {%- endif -%}
  {%- endfor -%}

  {%- if paginate.next -%}
    <a href="{{ paginate.next.url }}" class="pagination__item pagination__item--next" aria-label="{{ 'general.pagination.next' | t }}">
      {%- render 'icon-chevron-right', class: 'pagination__icon' -%}
    </a>
  {%- else -%}
    <span class="pagination__item pagination__item--disabled">
      {%- render 'icon-chevron-right', class: 'pagination__icon' -%}
    </span>
  {%- endif -%}
</nav>
{%- endif -%}
