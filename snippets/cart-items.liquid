{%- comment -%}
  Solaire Theme — Cart Items Snippet
  Renders the cart contents for both drawer and page views.
{%- endcomment -%}

{%- if cart.item_count > 0 -%}
  <ul class="cart-items" role="list">
    {%- for item in cart.items -%}
      <li class="cart-item" data-line="{{ forloop.index }}">
        <div class="cart-item__image">
          {%- if item.image -%}
            <img
              src="{{ item.image | image_url: width: 150 }}"
              alt="{{ item.title | escape }}"
              width="75"
              height="75"
              loading="lazy"
            >
          {%- endif -%}
        </div>

        <div class="cart-item__details">
          <h3 class="cart-item__title">
            <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
          </h3>

          {%- if item.product.has_only_default_variant == false -%}
            <p class="cart-item__variant">{{ item.variant.title | escape }}</p>
          {%- endif -%}

          <div class="cart-item__price">
            {%- render 'price', product: item.product -%}
          </div>

          <div class="cart-item__quantity">
            <label for="Quantity-{{ forloop.index }}" class="visually-hidden">
              {{ 'cart.general.quantity' | t }}
            </label>
            <input
              type="number"
              id="Quantity-{{ forloop.index }}"
              name="updates[]"
              value="{{ item.quantity }}"
              min="0"
              class="cart-item__qty-input"
              data-cart-quantity
              data-line="{{ forloop.index }}"
            >
          </div>
        </div>

        <button
          type="button"
          class="cart-item__remove"
          data-cart-remove
          data-line="{{ forloop.index }}"
          aria-label="{{ 'cart.general.remove' | t: title: item.title | escape }}"
        >
          {%- render 'icon-close' -%}
        </button>
      </li>
    {%- endfor -%}
  </ul>

  <div class="cart-footer">
    <div class="cart-footer__subtotal">
      <span>{{ 'cart.general.subtotal' | t }}</span>
      <span>{{ cart.total_price | money }}</span>
    </div>

    {%- if settings.cart_free_shipping_threshold != blank -%}
      {%- assign threshold = settings.cart_free_shipping_threshold | times: 100 -%}
      {%- if cart.total_price < threshold -%}
        {%- assign remaining = threshold | minus: cart.total_price -%}
        <p class="cart-footer__shipping-message">
          {{ 'cart.general.free_shipping_remaining' | t: amount: remaining | money }}
        </p>
      {%- else -%}
        <p class="cart-footer__shipping-message cart-footer__shipping-message--achieved">
          {{ 'cart.general.free_shipping_achieved' | t }}
        </p>
      {%- endif -%}
    {%- endif -%}

    <a href="{{ routes.cart_url }}" class="btn btn--primary cart-footer__view-cart">
      {{ 'cart.general.view_cart' | t }}
    </a>

    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="btn btn--accent cart-footer__checkout">
        {{ 'cart.general.checkout' | t }}
      </button>
    </form>
  </div>
{%- else -%}
  <div class="cart-empty">
    <p class="cart-empty__message">{{ 'cart.general.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">
      {{ 'cart.general.continue_shopping' | t }}
    </a>
  </div>
{%- endif -%}
