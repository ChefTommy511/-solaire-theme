{%- comment -%}
  Solaire Theme — Lazy Image Snippet
  Lazy-loaded, responsive <img> element with srcset support.
{%- endcomment -%}

{%- liquid
  assign image = image | default: nil
-%}
{%- if image != nil -%}
{%- liquid
  assign alt = alt | default: image.alt | default: ''
  assign class = class | default: ''
  assign sizes = sizes | default: '100vw'
  assign widths = widths | default: '375, 550, 750, 1100, 1500, 1780, 2000'
  assign loading = loading | default: 'lazy'
  assign decoding = decoding | default: 'async'
-%}

{%- if image != blank -%}
  <img
    src="{{ image | image_url: width: 10 }}"
    data-src="{{ image | image_url }}"
    data-srcset="{{ image | image_url: width: 10 }} 10w"
    data-sizes="auto"
    alt="{{ alt | escape }}"
    class="lazy-image {{ class }}"
    loading="{{ loading }}"
    decoding="{{ decoding }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
  >
  <noscript>
    <img
      src="{{ image | image_url: width: 800 }}"
      srcset="{%- for width in widths -%}{{ image | image_url: width: width }} {{ width }}w{% unless forloop.last %}, {% endunless %}{%- endfor -%}"
      sizes="{{ sizes }}"
      alt="{{ alt | escape }}"
      class="{{ class }}"
      loading="{{ loading }}"
      decoding="{{ decoding }}"
      width="{{ image.width }}"
      height="{{ image.height }}"
    >
  </noscript>
{%- endif -%}
{%- endif -%}
